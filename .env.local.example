# Fonte de dados do painel. Lida no servidor, em runtime — trocar aqui (ou na env da stack) não
# exige rebuild. Se não definida, vale o default em lib/config.ts, que aponta para a API do Comprec.
#
# Não use NEXT_PUBLIC_ neste nome: o Next inlina no bundle qualquer NEXT_PUBLIC_* presente durante o
# build, e a variável do Swarm passaria a ser ignorada em silêncio.
RANKING_API_URL=https://api.comprec.origindata.com.br/api/public/ranking

# Chave do painel, enviada no header X-Ranking-Key. Deixe vazia enquanto o backend estiver com
# RANKING_PUBLIC_KEY vazia (rota publica aberta). Server-only: nunca prefixe com NEXT_PUBLIC_.
# RANKING_API_KEY=

# O período vai explícito na query (?ano=&mes=), calculado em America/Sao_Paulo. Fixe um mês aqui
# para conferência e o painel respeita — sem parâmetros, ele usa sempre o mês corrente:
# RANKING_API_URL=https://api.comprec.origindata.com.br/api/public/ranking?ano=2026&mes=8
